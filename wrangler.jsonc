{
  "name": "watchmaker",
  "main": "preview/worker.mjs",
  "compatibility_date": "2026-11-23",
  "keep_vars": true,
  "vars": { "PREVIEW_PERSONAL_ENABLED": "true" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/p/*"]
  },
  "ratelimits": [
    { "name": "PERSONAL_BUILD_LIMIT", "namespace_id": "90423177", "simple": { "limit": 3, "period": 60 } },
    { "name": "PERSONAL_CAPACITY", "namespace_id": "90423178", "simple": { "limit": 12, "period": 60 } }
  ],
  "kv_namespaces": [
    { "binding": "PREVIEW_JOBS", "id": "1ca534dae046498793966b013b2b9d6d" }
  ]
}
